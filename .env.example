# Copie para .env.local e preencha com os valores reais (nunca comitar
# .env.local — já está no .gitignore).

# DSN do projeto Sentry (Settings → Client Keys (DSN) no painel do
# Sentry). Não é segredo — DSNs são feitos para ir no bundle do client —
# mas cada ambiente (dev/preview/produção) pode apontar para o mesmo
# projeto Sentry sem problema. Ver docs/OBSERVABILITY.md.
NEXT_PUBLIC_SENTRY_DSN=

# Auth token do Sentry, só necessário no build (upload de source maps).
# É um segredo de verdade — gere em sentry.io/settings/account/api/auth-tokens/
# com escopo "project:releases". Em produção, configurar direto na Vercel
# (Project Settings → Environment Variables), nunca aqui.
SENTRY_AUTH_TOKEN=
